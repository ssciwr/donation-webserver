{
  "name": "donation-webserver",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "lint": "prettier --check . && eslint .",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push",
    "start": "pnpm db:generate && pnpm db:push && node dist",
    "dev:start": "pnpm db:generate && pnpm db:push && node --env-file=.env dist",
    "format": "prettier --plugin-search-dir . --write .",
    "gh-pages": "npm run build && npx gh-pages -d build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.53.3",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/nodemailer": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.22.0",
    "flowbite": "^3.1.2",
    "flowbite-svelte": "^1.11.2",
    "flowbite-svelte-blocks": "^2.1.0",
    "flowbite-svelte-icons": "^2.2.1",
    "flowbite-typography": "^1.0.5",
    "globals": "^17.7.0",
    "mysql2": "^3.14.3",
    "postcss": "^8.5.10",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.53.5",
    "svelte-check": "^4.3.1",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "nodemailer": "^8.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
